# Copy to .env next to compose.yaml and fill in. Every variable here is
# referenced by compose.yaml; an empty one is passed through as empty.

# Container names: tailscale-${SERVICE} and app-${SERVICE}
SERVICE=applibris

# The machine name on your tailnet, so the library ends up at
# https://${SERVICE_HOSTNAME}.<your-tailnet>.ts.net
SERVICE_HOSTNAME=library

# Tailscale auth key from https://login.tailscale.com/admin/settings/keys
# Prefer a reusable, ephemeral-free key tagged for this node
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxx

# Host paths for the sidecar. The state directory holds the node's identity:
# lose it and the node rejoins as a new machine
TS_CONFIG_LOCATION=./tailscale/config
TS_STATE_LOCATION=./tailscale/state

# Pin a release; nothing floats in this registry
IMAGE_URL=ghcr.io/meandnano/applibris:0.2@

# The uid:gid the container runs as. It needs read access to
# LIBRARY_LOCATION and write access to DATA_LOCATION — `id -u` and `id -g`
# when the files are yours, the share owner's ids on a NAS
APP_UID=1000
APP_GID=1000

# Your EPUB and FB2 files, mounted read-only. Must exist, or startup fails
LIBRARY_LOCATION=/path/to/books

# Database and cover thumbnails
DATA_LOCATION=./data

# DEBUG, INFO, WARN or ERROR
LOG_LEVEL=INFO

# Send to Kindle through https://resend.com. Leave both empty to keep the
# send button hidden. RESEND_FROM must also be on your Amazon account's
# Approved Personal Document E-mail List
RESEND_API_KEY=
RESEND_FROM=

# Metadata providers to ask, in order. Empty disables enrichment and makes
# no outbound requests at all
METADATA_PROVIDERS=openlibrary,googlebooks

# Without a key Google Books uses the shared anonymous quota, which is
# routinely exhausted
GOOGLE_BOOKS_API_KEY=

# Timestamps in the UI are rendered in this zone
TZ=Etc/UTC

# Only needed if you uncomment the sidecar's dns: block
#DNS_SERVER=1.1.1.1
